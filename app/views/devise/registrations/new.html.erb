<h2><%= t('.sign_up') %></h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="field">
    <p><%= f.label :email %></p>
    <p><%= f.email_field :email, autofocus: true, autocomplete: "email" %></p>
  </div>

  <div class="field">
    <p><%= f.label :password %></p>
    <% if @minimum_password_length %>
      <p><em><%= t('devise.shared.minimum_password_length', count: @minimum_password_length) %></em></p>
    <% end %>
    <p><%= f.password_field :password, autocomplete: "new-password" %></p>
  </div>

  <div class="field">
    <p><%= f.label :password_confirmation %></p>
    <p><%= f.password_field :password_confirmation, autocomplete: "new-password" %></p>
  </div>

  <div class="field">
    <p><%= f.label :school_name %></p>
    <p><%= f.text_field :school_name, autocomplete: "organization" %></p>
  </div>

  <div class="field">
    <p><%= f.label :academic_year %></p>
    <p><%= f.text_field :academic_year, inputmode: "numeric", autocomplete: "off" %></p>
  </div>

  <div class="field">
    <p><%= f.label :current_enrollment %></p>
    <p><%= f.number_field :current_enrollment, min: 1, max: 10_000, step: 1 %></p>
  </div>

  <div class="actions">
    <%= f.submit t('.sign_up') %>
  </div>
<% end %>

<%= render "devise/shared/links" %>
