<%# 新規と編集で同じものを使う。form_with は @dish が新規か既存かを見て
    送り先（POST /dishes か PATCH /dishes/:id）を自分で決める %>
<%= form_with model: dish do |f| %>
  <%= error_summary(dish) %>

  <div class="field">
    <%= f.label :name, "料理名" %>
    <%= f.text_field :name %>
  </div>

  <div class="field">
    <%= f.label :category, "区分" %>
    <%# Dish.categories は enum が作るハッシュ。値をそのまま選択肢にする %>
    <%= f.select :category, Dish.category_options, { include_blank: "選んでください" } %>
  </div>

  <div class="actions">
    <%= f.submit %>
    <%= link_to "やめる", dishes_path %>
  </div>
<% end %>
