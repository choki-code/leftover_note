<h1>献立を登録する</h1>

<% if @dishes.empty? %>
  <p class="empty">まだ料理がありません。先に<%= link_to "料理マスタ", new_dish_path %>から料理を登録してください。</p>
<% else %>
  <%= form_with model: @menu do |f| %>
    <%= error_summary(@menu) %>

    <div class="field">
      <%= f.label :date_provided %>
      <%= f.date_field :date_provided %>
    </div>

    <div class="field">
      <%= f.label :attendance_count, "実食数（任意）" %>
      <%= f.number_field :attendance_count, min: 0 %>
    </div>

    <div class="table-scroll card">
      <table>
        <thead>
          <tr>
            <th>料理</th>
            <th>提供量（kg）</th>
          </tr>
        </thead>
        <tbody>

          <%= f.fields_for :menu_items do |item| %>
            <tr>
              <td>
                <%= item.collection_select :dish_id, @dishes, :id, :name,
                                          { include_blank: "選んでください" }, { "aria-label": "料理" } %>
              </td>
              <td>
                <%= item.number_field :portion_size, step: 0.01, min: 0, "aria-label": "提供量（kg）" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="actions">
      <%= f.submit "登録する" %>
      <%= link_to "やめる", root_path %>
    </div>
  <% end %>
<% end %>