<h1><%= l @menu.date_provided, format: :long %>の献立</h1>

<% if @menu.attendance_count.present? %>
  <p>実食数: <%= @menu.attendance_count %>人</p>
<% end %>

<% if @menu.excluded_from_stats? %>
  <p><span class="badge">対象外</span> この日は集計に含めません（理由: <%= @menu.exclusion_reason %>）</p>
<% end %>

<div class="table-scroll card">
  <table>
    <thead>
      <tr>
        <th>料理</th>
        <th>提供量</th>
        <th>残食量</th>
        <th>残食率</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
      <% deletable = @menu_items.size > 1 %>
      <% @menu_items.each do |item| %>
        <tr class="rate-<%= item.rate_level %>">
          <td><%= link_to item.dish.name, dish_path(item.dish) %></td>
          <td><%= item.portion_size %> kg</td>
          <% if item.leftover_rate.nil? %>
            <td>未入力</td>
            <td>—</td>
          <% else %>
            <td><%= item.weight_of_leftovers %> kg</td>
            <td><%= number_to_percentage(item.leftover_rate * 100, precision: 1) %></td>
          <% end %>
          <td>
            <% if deletable %>
              <% message = item.weight_of_leftovers.present? ? "「#{item.dish.name}」の残食記録と改善事項も消えます。削除しますか？" : "「#{item.dish.name}」を献立から削除しますか？" %>
              <%= button_to "削除", menu_menu_item_path(@menu, item), method: :delete,
                            class: "linklike", form: { data: { turbo_confirm: message } } %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="actions">
  <%= link_to "残食を入力する", edit_menu_leftovers_path(@menu), class: "btn btn-sub" %>
  <%= link_to "献立を編集する", edit_menu_path(@menu), class: "btn btn-sub" %>
  <%= link_to "続けて献立を登録する", new_menu_path, class: "btn btn-sub" %>
</div>
