<h1><%= l @menu.date_provided, format: :long %>の献立</h1>

<% if @menu.attendance_count.present? %>
  <p>実食数: <%= @menu.attendance_count %>人</p>
<% end %>

<div class="table-scroll card">
  <table>
    <thead>
      <tr>
        <th>料理</th>
        <th>提供量</th>
        <th>残食量</th>
        <th>残食率</th>
      </tr>
    </thead>
    <tbody>
      <% @menu_items.each do |item| %>
        <tr class="rate-<%= item.rate_level %>">
          <td><%= item.dish.name %></td>
          <td><%= item.portion_size %> kg</td>
          <% if item.leftover_rate.nil? %>
            <td>未入力</td>
            <td>—</td>
          <% else %>
            <td><%= item.weight_of_leftovers %> kg</td>
            <td><%= number_to_percentage(item.leftover_rate * 100, precision: 1) %></td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="actions">
  <%= link_to "残食を入力する", edit_menu_leftovers_path(@menu) %>
  <%= link_to "続けて献立を登録する", new_menu_path %>
</div>