<h1>分析シート</h1>
<p class="page-note">集計対象外の日と、残食が未入力の品目は含めません。</p>

<div class="card">
  <% if @yearly_rates.empty? %>
    <p class="empty">まだ記録がありません。</p>
  <% else %>
    <% @yearly_rates.each do |row| %>
      <div class="bar-row">
        <div class="bar-label">
          <span><%= row.fiscal_year %>年度</span>
          <span><%= number_to_percentage(row.rate * 100, precision: 1) %></span>
        </div>
        <div class="bar-track">
          <div class="bar-fill" style="width: <%= (row.rate * 100).round(1) %>%"></div>
        </div>
      </div>
    <% end %>
    <% if @yearly_rates.length == 1 %>
      <p class="bar-note"><%= @yearly_rates.first.fiscal_year + 1 %>年度の記録が入ると、年度どうしを比べられます。</p>
    <% end %>
  <% end %>
</div>

<div class="card">
  <% if @ranking.empty? %>
    <p class="empty">今年度の記録がまだありません。</p>
  <% else %>
    <% @ranking.each do |row| %>
      <div class="bar-row">
        <div class="bar-label">
          <span><%= link_to row.dish_name, dish_path(row.dish_id) %>（提供<%= row.served_count %>回）</span>
          <span><%= number_to_percentage(row.rate * 100, precision: 1) %></span>
        </div>
        <div class="bar-track">
          <div class="bar-fill" style="width: <%= (row.rate * 100).round(1) %>%"></div>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
